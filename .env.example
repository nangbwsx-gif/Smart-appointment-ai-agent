# 复制为 .env 后按需填写（.env 已被 .gitignore 忽略，不要提交）

# 对话模型：azure | openai | qwen | deepseek | zhipu | openai-compatible
MODEL_PROVIDER=openai-compatible
LLM_API_KEY=
LLM_BASE_URL=https://api.minimax.chat/v1
LLM_MODEL=MiniMax-M3.1-Flash

# 向量模型：azure | openai | qwen | zhipu | openai-compatible | minimax
# minimax 用原生接口（texts/type），其余走 OpenAI 兼容格式（input）
EMBEDDING_PROVIDER=minimax
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.minimax.chat/v1
EMBEDDING_MODEL=embo-01

# 数据库（默认 sqlite:///data/smart_appointment.db，目录会自动创建）
DATABASE_URL=sqlite:///data/smart_appointment.db

# 天气工具（可选，不填则使用内置文案）
OPENWEATHER_API_KEY=
